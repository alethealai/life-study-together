rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(gardenId) {
      return signedIn() && exists(/databases/$(database)/documents/gardens/$(gardenId)/members/$(request.auth.uid));
    }
    function gardenDeveloper(gardenId) {
      return signedIn() && get(/databases/$(database)/documents/gardens/$(gardenId)).data.ownerUid == request.auth.uid;
    }
    function platformDeveloper() {
      return signedIn() && get(/databases/$(database)/documents/gardens/main).data.ownerUid == request.auth.uid;
    }
    function mine() { return signedIn() && resource.data.uid == request.auth.uid; }

    function validName(name) { return name is string && name.size() > 0 && name.size() <= 40; }
    function initialMember(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid','name','email','role','onboardingComplete','joinCode','baseBible','baseLife','bibleProgress','lifeProgress','bibleRead','lifeRead','readingDates','joinedAt','schemaVersion','revision','logCount','lastReadDate'])
        && d.onboardingComplete == false && d.uid == uid && d.email == request.auth.token.email && validName(d.name)
        && d.baseBible == 0 && d.baseLife == 0 && d.bibleProgress == 0 && d.lifeProgress == 0
        && d.bibleRead == 0 && d.lifeRead == 0 && d.readingDates == [] && d.joinedAt == request.time
        && d.schemaVersion == 2 && d.revision == 0 && d.logCount == 0 && d.lastReadDate == null;
    }
    function smallPage() { return request.query.limit != null && request.query.limit <= 24; }
    function initialSummary(m) {
      return {'uid':m.uid, 'name':m.name, 'bibleProgress':0, 'lifeProgress':0, 'cwwlProgress':0, 'lastReadDate':null};
    }
    function initialProgress(m) {
      return {'uid':m.uid, 'name':m.name, 'onboardingComplete':false, 'lastLogId':null, 'lastCorrection':null, 'baseBible':0, 'baseLife':0, 'baseCwwl':0,
        'bibleProgress':0, 'lifeProgress':0, 'cwwlProgress':0, 'bibleRead':0, 'lifeRead':0, 'cwwlRead':0,
        'archivedBibleRead':0, 'archivedLifeRead':0, 'archivedCwwlRead':0,
        'revision':0, 'logCount':0, 'inventoryRevision':0, 'lastReadDate':null, 'streakEndDate':null, 'streakLength':0};
    }
    function initialView(gardenId, uid, publicView) {
      let m = getAfter(/databases/$(database)/documents/gardens/$(gardenId)/members/$(uid)).data;
      return signedIn() && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/gardens/$(gardenId)/members/$(uid))
        && m.uid == uid && m.revision == 0
        && request.resource.data == (publicView ? initialSummary(m) : initialProgress(m));
    }

    match /gardens/{gardenId} {
      allow read: if member(gardenId);
      allow create: if platformDeveloper() && !exists(/databases/$(database)/documents/gardens/$(gardenId))
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if gardenDeveloper(gardenId) && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode']);
      allow delete: if false;

      match /allowedEmails/{emailId} {
        allow read: if signedIn() && (gardenDeveloper(gardenId) || emailId == request.auth.token.email);
        allow create: if gardenDeveloper(gardenId);
        allow update: if (
          gardenDeveloper(gardenId)
          && request.resource.data.claimedUid == resource.data.claimedUid
        ) || (
          signedIn()
          && emailId == request.auth.token.email
          && resource.data.claimedUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid', 'claimedAt'])
          && request.resource.data.claimedUid == request.auth.uid
        );
        allow delete: if gardenDeveloper(gardenId) && resource.data.claimedUid == null;
      }

      match /members/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow list: if false;
        allow create: if signedIn() && uid == request.auth.uid && initialMember(uid)
          && getAfter(/databases/$(database)/documents/gardens/$(gardenId)/memberSummaries/$(uid)).data == initialSummary(request.resource.data)
          && getAfter(/databases/$(database)/documents/gardens/$(gardenId)/members/$(uid)/private/progress).data == initialProgress(request.resource.data) && (
          (
            getAfter(/databases/$(database)/documents/gardens/$(gardenId)).data.ownerUid == request.auth.uid
            && request.resource.data.role in ['developer', 'owner']
          ) || (
            request.resource.data.role == 'member'
            && request.resource.data.joinCode is string
            && get(/databases/$(database)/documents/gardenInvites/$(request.resource.data.joinCode)).data.gardenId == gardenId
            && get(/databases/$(database)/documents/gardenInvites/$(request.resource.data.joinCode)).data.active == true
          )
        );
        // All progress and baseline mutations go through trusted transactions.
        allow update, delete: if false;
        match /private/{viewId} {
          allow get: if signedIn() && uid == request.auth.uid && member(gardenId);
          allow create: if viewId == 'progress' && initialView(gardenId,uid,false);
          allow update, delete, list: if false;
        }
        match /withdrawnReadings/{logId} {
          allow get: if signedIn() && uid == request.auth.uid && member(gardenId);
          allow list: if signedIn() && uid == request.auth.uid && member(gardenId) && smallPage();
          allow write: if false;
        }
        match /requests/{requestId} { allow read, write: if false; }
        match /readingPeriods/{periodId} {
          allow get: if signedIn() && uid == request.auth.uid && member(gardenId);
          allow list: if signedIn() && uid == request.auth.uid && member(gardenId) && smallPage();
          allow write: if false;
        }
      }

      match /memberSummaries/{uid} {
        allow read: if member(gardenId);
        allow create: if initialView(gardenId,uid,true);
        allow update, delete: if false;
      }
      match /placements/{placementId} {
        allow get: if member(gardenId);
        allow list: if member(gardenId) && request.query.limit != null && request.query.limit <= 200;
        allow write: if false;
      }
      match /placementLinks/{placementId} { allow read, write: if false; }

      match /plans/{planId} { allow read: if member(gardenId); allow write: if false; }

      match /logs/{logId} {
        allow get: if member(gardenId) && mine();
        allow list: if member(gardenId) && mine() && smallPage();
        allow create: if false;
        allow update: if member(gardenId) && mine()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
          && request.resource.data.note is string && request.resource.data.note.size() <= 2000;
        allow delete: if false;
      }

      match /rewards/{rewardId} {
        allow get: if member(gardenId) && mine();
        allow list: if member(gardenId) && mine() && smallPage();
        allow write: if false;
      }
    }

    match /gardenInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if platformDeveloper()
        && request.resource.data.gardenId is string
        && getAfter(/databases/$(database)/documents/gardens/$(request.resource.data.gardenId)).data.ownerUid == request.auth.uid;
      allow delete: if platformDeveloper();
    }

    match /users/{uid}/gardens/{gardenId} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/gardens/$(gardenId)/members/$(uid)).data.uid == uid
        && request.resource.data.role == getAfter(/databases/$(database)/documents/gardens/$(gardenId)/members/$(uid)).data.role;
      allow delete: if false;
    }
  }
}
